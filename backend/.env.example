# ============================================================
# Research Agent - Environment Example
#
# 使用方法：
#
# 1. 复制这个文件
#
# backend/.env.example
#
# 为：
#
# backend/.env
#
# 2. 填写真实配置
#
# 3. 不要提交 backend/.env
# ============================================================


# ============================================================
# Application
# ============================================================

APP_NAME=Research Agent API

APP_VERSION=0.1.0

ENVIRONMENT=development

DEBUG=true

API_V1_PREFIX=/api/v1


# ============================================================
# Security
# ============================================================

# 请使用安全随机字符串替换。
#
# 不要把真实 SECRET_KEY 写入 .env.example。
SECRET_KEY=change-me

# ============================================================
# JWT
# ============================================================

JWT_ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================================
# PostgreSQL
# ============================================================

POSTGRES_USER=postgres

POSTGRES_PASSWORD=change-me

POSTGRES_DB=research_agent

POSTGRES_HOST=localhost

POSTGRES_PORT=5432


# ============================================================
# Logging
# ============================================================

LOG_LEVEL=DEBUG


# ============================================================
# CORS
# ============================================================

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ============================================================
# External HTTP Client
# ============================================================

HTTP_CONNECT_TIMEOUT=10
HTTP_READ_TIMEOUT=30
HTTP_WRITE_TIMEOUT=10
HTTP_POOL_TIMEOUT=10

HTTP_MAX_CONNECTIONS=50
HTTP_MAX_KEEPALIVE_CONNECTIONS=20


# ============================================================
# Crossref
# ============================================================

CROSSREF_BASE_URL=https://api.crossref.org/v1
CROSSREF_USER_AGENT=Research-Agent/0.1

# ============================================================
# arXiv
# ============================================================

ARXIV_API_URL=https://export.arxiv.org/api/query

ARXIV_MIN_REQUEST_INTERVAL_SECONDS=3

ARXIV_MAX_PAGE_SIZE=50

# ============================================================
# OpenAlex
# ============================================================

OPENALEX_BASE_URL=https://api.openalex.org

# Optional:
# Basic development requests can work without a key.
OPENALEX_API_KEY=

OPENALEX_MAX_PAGE_SIZE=50

OPENALEX_BASE_URL=https://api.openalex.org
OPENALEX_MAX_PAGE_SIZE=50

# ============================================================
# Redis
# ============================================================

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Optional
REDIS_PASSWORD=

PAPER_SEARCH_CACHE_TTL_SECONDS=300
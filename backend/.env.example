# ============================================================
# Research Agent - Environment Example
#
# 使用方法：
#
# 1. 复制这个文件
#
# backend/.env.example
#
# 为：
#
# backend/.env
#
# 2. 填写真实配置
#
# 3. 不要提交 backend/.env
# ============================================================


# ============================================================
# Application
# ============================================================

APP_NAME=Research Agent API

APP_VERSION=0.1.0

ENVIRONMENT=development

DEBUG=true

API_V1_PREFIX=/api/v1


# ============================================================
# Security
# ============================================================

# 请使用安全随机字符串替换。
#
# 不要把真实 SECRET_KEY 写入 .env.example。
SECRET_KEY=change-me

# ============================================================
# JWT
# ============================================================

JWT_ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================================
# PostgreSQL
# ============================================================

POSTGRES_USER=postgres

POSTGRES_PASSWORD=change-me

POSTGRES_DB=research_agent

POSTGRES_HOST=localhost

POSTGRES_PORT=5433


# ============================================================
# Logging
# ============================================================

LOG_LEVEL=DEBUG


# ============================================================
# CORS
# ============================================================

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ============================================================
# External HTTP Client
# ============================================================

HTTP_CONNECT_TIMEOUT=10
HTTP_READ_TIMEOUT=30
HTTP_WRITE_TIMEOUT=10
HTTP_POOL_TIMEOUT=10

HTTP_MAX_CONNECTIONS=50
HTTP_MAX_KEEPALIVE_CONNECTIONS=20


# ============================================================
# Crossref
# ============================================================

CROSSREF_BASE_URL=https://api.crossref.org/v1
CROSSREF_USER_AGENT=Research-Agent/0.1

# ============================================================
# arXiv
# ============================================================

ARXIV_API_URL=https://export.arxiv.org/api/query

ARXIV_MIN_REQUEST_INTERVAL_SECONDS=3

ARXIV_MAX_PAGE_SIZE=50

# ============================================================
# OpenAlex
# ============================================================

OPENALEX_BASE_URL=https://api.openalex.org

# Optional:
# Basic development requests can work without a key.
OPENALEX_API_KEY=

OPENALEX_MAX_PAGE_SIZE=50

OPENALEX_BASE_URL=https://api.openalex.org
OPENALEX_MAX_PAGE_SIZE=50

# ============================================================
# Redis
# ============================================================

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Optional
REDIS_PASSWORD=

PAPER_SEARCH_CACHE_TTL_SECONDS=300

# ============================================================
# Celery
# ============================================================

CELERY_BROKER_DB=1
CELERY_RESULT_DB=2
CELERY_RESULT_EXPIRES_SECONDS=3600

# ============================================================
# Text Chunking
# ============================================================

CHUNKER_NAME=token_window
CHUNK_TOKENIZER_NAME=cl100k_base

CHUNK_SIZE_TOKENS=384
CHUNK_OVERLAP_TOKENS=64

# ============================================================
# Embedding
# ============================================================

EMBEDDING_PROVIDER=sentence_transformer

EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-small

EMBEDDING_DEVICE=auto

EMBEDDING_BATCH_SIZE=32

EMBEDDING_DIMENSION=384

EMBEDDING_NORMALIZE=true

EMBEDDING_REJECT_TRUNCATION=true

EMBEDDING_PREVIEW_MAX_CHUNKS=10


# ============================================================
# Vector Persistence
# ============================================================

EMBEDDING_JOB_BATCH_SIZE=64

VECTOR_HNSW_M=16
VECTOR_HNSW_EF_CONSTRUCTION=64

# ============================================================
# Semantic Retrieval
# ============================================================

RETRIEVAL_DEFAULT_TOP_K=5
RETRIEVAL_MAX_TOP_K=20
RETRIEVAL_DEFAULT_MIN_SCORE=0.0
RETRIEVAL_MAX_QUERY_LENGTH=1000

# ============================================================
# Hybrid Retrieval
# ============================================================

HYBRID_SEMANTIC_CANDIDATES=20
HYBRID_LEXICAL_CANDIDATES=20
HYBRID_FUSION_CANDIDATES=20

HYBRID_DEFAULT_TOP_K=5
HYBRID_MAX_TOP_K=20

HYBRID_RRF_K=60

HYBRID_FTS_CONFIG=simple

# ============================================================
# Reranker
# ============================================================

RERANKER_ENABLED=true

RERANKER_MODEL_NAME=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1

RERANKER_DEVICE=auto

RERANKER_BATCH_SIZE=16

# ============================================================
# LLM / RAG
# ============================================================

LLM_PROVIDER=huggingface
LLM_MODEL_NAME=Qwen/Qwen2.5-1.5B-Instruct
LLM_DEVICE=auto

LLM_MAX_NEW_TOKENS=512
LLM_TEMPERATURE=0.1
LLM_DO_SAMPLE=false

RAG_DEFAULT_TOP_K=5
RAG_MAX_TOP_K=10
RAG_MAX_CONTEXT_CHARS=12000

RAG_REQUIRE_EVIDENCE=true

# ============================================================
# Prompt Management
# ============================================================

RAG_SYSTEM_PROMPT_VERSION=1
RAG_USER_PROMPT_VERSION=1

# ============================================================
# LangChain
# ============================================================

# native:
#   directly call custom LLMProvider
#
# langchain:
#   use LCEL generation pipeline
RAG_GENERATION_ENGINE=langchain

# ============================================================
# LangGraph
# ============================================================

# service:
#   classic service orchestration
#
# langgraph:
#   StateGraph orchestration
RAG_WORKFLOW_ENGINE=langgraph

# ============================================================
# Research Agent
# ============================================================

# service:
#     classic RAG service
#
# langgraph:
#     basic LangGraph RAG
#
# agent:
#     agentic RAG with query analysis/rewrite/retry
RAG_WORKFLOW_ENGINE=agent

# Maximum total retrieval attempts per question.
RESEARCH_AGENT_MAX_RETRIEVAL_ATTEMPTS=2

# Candidate count used internally by Research Agent.
RESEARCH_AGENT_RETRIEVAL_TOP_K=8

# Maximum chunks sent to evidence evaluator.
RESEARCH_AGENT_EVALUATION_MAX_CHUNKS=5

# ============================================================
# Tool Calling
# ============================================================

# service
# langgraph
# agent
# tool_agent
RAG_WORKFLOW_ENGINE=tool_agent

RESEARCH_AGENT_MAX_TOOL_CALLS=3
TOOL_SELECTION_PROMPT_VERSION=1

# ============================================================
# Multi-Agent
# ============================================================

# service
# langgraph
# agent
# tool_agent
# multi_agent
RAG_WORKFLOW_ENGINE=multi_agent

MULTI_AGENT_MAX_RESEARCH_CYCLES=2
MULTI_AGENT_CRITIC_MAX_CHUNKS=5

# ============================================================
# Paper Comparison
# ============================================================

PAPER_COMPARISON_MAX_PAPERS=5
PAPER_COMPARISON_PER_PAPER_TOP_K=5
PAPER_COMPARISON_PROMPT_VERSION=1

# ============================================================
# Research Gap Discovery
# ============================================================

RESEARCH_GAP_MAX_CANDIDATES=5
RESEARCH_GAP_GENERATION_PROMPT_VERSION=1
RESEARCH_GAP_VERIFICATION_PROMPT_VERSION=1
RESEARCH_GAP_STRONG_SUPPORT_MIN_PAPERS=3

# ============================================================
# Experiment Design
# ============================================================

EXPERIMENT_DESIGN_PROMPT_VERSION=1
EXPERIMENT_REVIEW_PROMPT_VERSION=1
EXPERIMENT_DEFAULT_REPEATED_RUNS=5
EXPERIMENT_DEFAULT_ALPHA=0.05

# ============================================================
# Code Assistant
# ============================================================

CODE_ASSISTANT_PLANNING_PROMPT_VERSION=1
CODE_ASSISTANT_PATCH_PROMPT_VERSION=1
CODE_ASSISTANT_REVIEW_PROMPT_VERSION=1
CODE_ASSISTANT_VALIDATION_PROMPT_VERSION=1

CODE_ASSISTANT_MAX_FILE_CHANGES=8

CODE_ASSISTANT_BLOCKED_PATH_KEYWORDS=.env,secrets,credentials,private_key,security/

# ============================================================
# LangSmith Observability
# ============================================================

LANGSMITH_ENABLED=false

LANGSMITH_API_KEY=

LANGSMITH_ENDPOINT=https://api.smith.langchain.com

LANGSMITH_PROJECT=research-agent-dev

LANGSMITH_WORKSPACE_ID=

LANGSMITH_ENVIRONMENT=development

LANGSMITH_CAPTURE_CONTENT=false

LANGSMITH_OMIT_RUNTIME_INFO=true

LANGSMITH_EXCLUDED_PATHS=/health,/docs,/redoc,/openapi.json